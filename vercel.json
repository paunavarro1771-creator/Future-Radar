{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/u17-squads.js": {
      "includeFiles": "node_modules/pdfjs-dist/legacy/build/pdf.worker.js",
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/players/:slug",
      "destination": "/detail.html"
    },
    {
      "source": "/players/:slug/",
      "destination": "/detail.html"
    },
    {
      "source": "/academies/:slug",
      "destination": "/detail.html"
    },
    {
      "source": "/academies/:slug/",
      "destination": "/detail.html"
    },
    {
      "source": "/matches/:slug",
      "destination": "/detail.html"
    },
    {
      "source": "/matches/:slug/",
      "destination": "/detail.html"
    },
    {
      "source": "/compare",
      "destination": "/compare/index.html"
    },
    {
      "source": "/compare/",
      "destination": "/compare/index.html"
    },
    {
      "source": "/scouting",
      "destination": "/scouting/index.html"
    },
    {
      "source": "/scouting/",
      "destination": "/scouting/index.html"
    }
  ]
}